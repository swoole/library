<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    backupGlobals="false"
    bootstrap="tests/bootstrap.php"
    beStrictAboutTestsThatDoNotTestAnything="false"
    cacheResultFile=".phpunit.cache/test-results"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd">
  <testsuites>
    <!--
      Run with ./vendor/bin/counit, which puts the whole run inside one coroutine and gives every test its own,
      so time/IO bound tests overlap instead of queueing up behind each other.
    -->
    <testsuite name="concurrent">
      <directory suffix="Test.php">tests/unit</directory>
      <exclude>tests/unit/Thread</exclude>
      <exclude>tests/unit/Coroutine/FunctionTest.php</exclude>
      <exclude>tests/unit/Coroutine/HttpFunctionTest.php</exclude>
      <exclude>tests/unit/Database/PDOPoolTest.php</exclude>
      <exclude>tests/unit/Database/RedisPoolTest.php</exclude>
      <exclude>tests/unit/Process/ProcessManagerTest.php</exclude>
    </testsuite>
    <!--
      Run with ./vendor/bin/phpunit. These tests cannot share a run with the ones above:

      - Coroutine/FunctionTest calls Swoole\Runtime::setHookFlags() directly in its test bodies. That takes
        effect process-wide and immediately, even from inside a running coroutine, so it turns on the STDIO
        and file hooks counit excludes on purpose and then unhooks everything for whatever is in flight;
        with it running concurrently, Barrier and Http2/MultiplexClient failed every time. It also calls
        sleep()/usleep() unqualified from namespace Swoole\Coroutine, where counit installs shims of its
        own, so under counit it would stop exercising Swoole's sleep hook altogether.
      - Coroutine/HttpFunctionTest sets the process-wide http_client_driver option, which
        Coroutine\Http\request() reads on every call. Concurrent tests overwrite each other's choice after
        the first yield, so the driver-specific tests silently stop testing the driver they selected.
      - Database/PDOPoolTest::testOracle blocks the scheduler: PDO_OCI is not coroutine-hooked, so its round
        trips are blocking syscalls and no timer fires meanwhile. Measured at roughly 0.9s of timer lateness
        for every other test in the run, which invalidates any wall-clock assertion in the concurrent suite.
      - Database/RedisPoolTest sets a server-wide `requirepass` and creates ACL users on the shared Redis
        server. That is invisible while tests run one at a time, but it breaks any test using Redis
        concurrently: NameResolverTest's Redis cases fail whenever the two overlap.
      - Process/ProcessManagerTest forks worker processes, and Swoole refuses to fork from inside a
        coroutine ("must be forked outside the coroutine" from Swoole\Process\Pool::start()). Under counit
        the run dies at exit 255 with no summary at all, because PHPUnit's output buffer swallows the fatal.
    -->
    <testsuite name="serial">
      <file>tests/unit/Coroutine/FunctionTest.php</file>
      <file>tests/unit/Coroutine/HttpFunctionTest.php</file>
      <file>tests/unit/Database/PDOPoolTest.php</file>
      <file>tests/unit/Database/RedisPoolTest.php</file>
      <file>tests/unit/Process/ProcessManagerTest.php</file>
    </testsuite>
  </testsuites>
  <extensions>
    <extension class="Deminy\Counit\CounitExtension"/>
  </extensions>
  <php>
    <ini name="error_reporting" value="-1"/>
    <ini name="display_errors" value="On"/>
    <ini name="display_startup_errors" value="On"/>
  </php>
</phpunit>
